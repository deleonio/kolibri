{
	"name": "@public-ui/schema",
	"version": "3.0.2",
	"license": "EUPL-1.2",
	"homepage": "https://public-ui.github.io",
	"repository": {
		"type": "git",
		"url": "https://github.com/public-ui/kolibri"
	},
	"bugs": {
		"url": "https://github.com/public-ui/kolibri/issues",
		"email": "kolibri@itzbund.de"
	},
	"author": {
		"name": "Informationstechnikzentrum Bund",
		"email": "kolibri@itzbund.de"
	},
	"description": "Shared property schema for KoliBri components.",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "rollup -c",
		"dev": "rollup -c --watch",
		"format": "prettier --check src",
		"lint": "pnpm lint:eslint && pnpm lint:tsc",
		"lint:eslint": "eslint src",
		"lint:tsc": "tsc --noemit"
	},
	"dependencies": {
		"adopted-style-sheets": "1.1.9-rc.19",
		"color-convert": "3.1.0",
		"color-rgba": "2.4.0",
		"query-selector-all-shadow-root": "0.0.3",
		"query-selector-shadow-root": "0.0.3",
		"rgba-convert": "0.3.0",
		"wcag-contrast": "3.0.0"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "28.0.5",
		"@rollup/plugin-node-resolve": "16.0.1",
		"@rollup/plugin-typescript": "12.1.2",
		"@typescript-eslint/eslint-plugin": "7.18.0",
		"@typescript-eslint/parser": "7.18.0",
		"eslint": "8.57.1",
		"rollup": "4.43.0",
		"typescript": "5.8.3"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	]
}
