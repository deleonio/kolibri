{
	"name": "@public-ui/presentation",
	"version": "4.3.0-rc.1",
	"description": "This package contains presentation samples for the KoliBri/Public UI",
	"license": "EUPL-1.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/public-ui/kolibri"
	},
	"scripts": {
		"build": "vite build",
		"build:deps": "pnpm --filter @public-ui/presentation^... build",
		"format": "prettier --check src",
		"lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:tsc",
		"lint:eslint": "eslint src",
		"lint:stylelint": "stylelint \"src/**/*.{css,scss}\"",
		"lint:tsc": "tsc --noemit",
		"prebuild": "npm-run-all2 prebuild:*",
		"prebuild:components": "cpy \"node_modules/@public-ui/components/assets/**/*\" public/assets --dot",
		"prebuild:themes": "cpy \"node_modules/@public-ui/themes/assets/**/*\" public/assets --dot",
		"prepare": "pnpm prebuild",
		"serve": "vite",
		"start": "vite --open",
		"unused": "knip"
	},
	"dependencies": {
		"@public-ui/components": "workspace:*",
		"@public-ui/react-v19": "workspace:*",
		"@public-ui/sample-react": "workspace:*",
		"@public-ui/themes": "workspace:*",
		"adopted-style-sheets": "1.1.9-rc.25",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-router-dom": "7.18.3"
	},
	"devDependencies": {
		"@types/node": "25.9.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/eslint-plugin": "8.58.2",
		"@typescript-eslint/parser": "8.58.2",
		"@unocss/preset-mini": "66.10.2",
		"@unocss/vite": "66.10.2",
		"@vitejs/plugin-react-swc": "4.3.3",
		"cpy-cli": "7.0.0",
		"eslint": "9.39.5",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"knip": "6.35.1",
		"npm-run-all2": "8.0.4",
		"prettier": "3.9.6",
		"prettier-plugin-organize-imports": "4.3.0",
		"stylelint": "17.15.0",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	},
	"files": [
		"dist",
		"public",
		"src",
		"index.html",
		"tsconfig.json",
		"unocss.config.ts",
		"vite.config.ts"
	]
}
